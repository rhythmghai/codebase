# Copy to .env and fill in. See common/config.py for full docs on each of these.

# --- Auth (required for any public/production deployment) ---
# Comma-separated list of accepted API keys for the X-API-Key header.
# Leaving this unset DISABLES auth entirely -- fine for local dev only.
API_KEYS=

# Comma-separated list of allowed CORS origins. Unset = wide open ("*"),
# which is fine for local dev but should be set explicitly in production.
ALLOWED_ORIGINS=

# --- Storage (persistence caveat: see DATA_DIR's docstring in common/config.py) ---
DATA_DIR=
WORKSPACE_ROOT=

# --- Rate limits (per client identity: API key, or shared "anonymous" bucket when auth is disabled) ---
QUERY_RATE_LIMIT_PER_MIN=15
INGEST_RATE_LIMIT_PER_MIN=3
MAX_ACTIVE_REPOS=5
LLM_TIMEOUT_SECONDS=20

LOG_LEVEL=INFO

# --- LLM backend (optional -- falls back to a deterministic rule-based
#     stand-in if unset, see orchestration/llm_client.py) ---
GOOGLE_API_KEY=

# --- Graph database (optional -- falls back to local JSON graph traversal
#     if unset, see storage/neo4j_client.py) ---
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Vector database (storage/vector_store.py). Unlike Neo4j, this is NOT
#     optional -- vector search always runs through Qdrant. Leaving both
#     QDRANT_URL and QDRANT_PATH unset uses embedded/local mode by default,
#     persisted under DATA_DIR/qdrant -- no account or server needed. Set
#     QDRANT_URL (+ QDRANT_API_KEY) to point at a real hosted/self-hosted
#     Qdrant instance instead, with zero code changes. ---
QDRANT_PATH=
QDRANT_URL=
QDRANT_API_KEY=
